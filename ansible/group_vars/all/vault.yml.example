---
# ===========================================================================
# TEMPLATE for group_vars/all/vault.yml (which is git-ignored and never
# committed).
#
# CI: the `provision` workflow writes vault.yml from GitHub Environment secrets
#     (K3S_TOKEN, WG_PRIVATE_KEYS) - you do not create it there.
#
# Local runs:
#     cp group_vars/all/vault.example.yml group_vars/all/vault.yml
#     # put real values in, then:
#     ansible-vault encrypt group_vars/all/vault.yml
#     ansible-playbook site.yml --ask-vault-pass
# ===========================================================================

# K3s cluster join token. Treat like a root password.
#   openssl rand -hex 32
vault_k3s_token: "REPLACE_ME"

# WireGuard private keys for the pod-mesh link (wg0), one per node that rides it
# (k3s_flannel_iface = wg0). Generate each with `wg genkey`; the matching
# `wg pubkey` output goes in inventory/hosts.yml as wg_public_key (non-secret).
# CI passes this as the WG_PRIVATE_KEYS secret (JSON: {"kube-cp-01": "...", ...}).
vault_wg_private_keys:
  kube-cp-01: "REPLACE_ME"
  kube-worker-01: "REPLACE_ME"

# The Headscale pre-auth key used to `tailscale up` each node is applied BY HAND,
# one-time, per node - not by Ansible. See the README "Adding a worker node".
