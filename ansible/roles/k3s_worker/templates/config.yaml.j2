{{ ansible_managed | comment }}
# /etc/rancher/k3s/config.yaml - K3s agent. Manual edits are overwritten.

token: "{{ vault_k3s_token }}"
# Joined over the WireGuard pod-mesh link - kube-cp-01's public :6443 is
# firewalled, and the mesh has no control-server dependency to deadlock on.
server: "https://{{ k3s_cp_wg_ip }}:{{ k3s_api_port }}"

# Pin the node name - the OS hostname on a fresh Pi is whatever the image
# shipped (e.g. "pi4"), and cloud-init can reset it on reboot.
node-name: "{{ inventory_hostname }}"

node-label:
{% for label in node_labels | default([]) %}
  - "{{ label }}"
{% endfor %}

{% if node_taints | default([]) | length > 0 %}
node-taint:
{% for taint in node_taints %}
  - "{{ taint }}"
{% endfor %}
{% endif %}
{% if node_ip | default('') %}
# This node's wg0 address, so the apiserver can reach the kubelet (logs / exec /
# port-forward) over the pod mesh - its real NIC is a private LAN / VPN address.
node-ip: "{{ node_ip }}"
{% endif %}
{% if k3s_flannel_iface %}
# Pod mesh over the WireGuard link - must match the server (VXLAN endpoint =
# this node's wg_ip). A drop-in orders k3s-agent After=wg-quick@{{ k3s_flannel_iface }}.
flannel-iface: "{{ k3s_flannel_iface }}"
{% endif %}
{% if k3s_resolv_conf_manage | bool %}
resolv-conf: /etc/rancher/k3s/resolv.conf
{% endif %}
