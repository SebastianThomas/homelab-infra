{{ ansible_managed | comment }}
# /etc/rancher/k3s/config.yaml - K3s server. Manual edits are overwritten.

token: "{{ vault_k3s_token }}"
write-kubeconfig-mode: "0600"

# Embedded SQLite datastore is the default: no `cluster-init`, no
# `datastore-endpoint`. The server stays schedulable (K3s adds no taint), so
# kube-cp-01 can run the whole cluster on its own.

node-label:
{% for label in node_labels | default([]) %}
  - "{{ label }}"
{% endfor %}

tls-san:
  - "{{ inventory_hostname }}"
  - "{{ ansible_host }}"
{% if node_ip_public is defined and node_ip_public %}
  - "{{ node_ip_public }}"
{% endif %}
{% for san in extra_tls_san | default([]) %}
  - "{{ san }}"
{% endfor %}
{% if k3s_cp_tailscale_ip %}
  # Tailnet: MagicDNS name + IP so clients/CI/agents reach the API over the tailnet.
  - "{{ inventory_hostname }}.ts.{{ cluster_domain }}"
  - "{{ k3s_cp_tailscale_ip }}"
{% endif %}

kubelet-arg:
  - "eviction-hard=memory.available<100Mi,nodefs.available<10%,imagefs.available<10%"
{% if k3s_resolv_conf_manage | bool %}
resolv-conf: /etc/rancher/k3s/resolv.conf
{% endif %}
{% if k3s_cp_namespace_scheduling | bool %}

# Let a namespace pin all its pods to a node (annotations set by
# kubernetes/apps/<app>/namespace.yaml). No-op for namespaces without the
# annotations. Lets app repos ship placement-agnostic Deployments.
kube-apiserver-arg:
  - "enable-admission-plugins=PodNodeSelector,PodTolerationRestriction"
{% endif %}
{% if k3s_flannel_iface %}

# Pod mesh over the tailnet: flannel's VXLAN rides the tailscale0 interface
# (endpoint = this node's 100.64.x.x, MTU from tailscale0). k3s then also uses
# that IP as the node InternalIP - fine, klipper still binds :80/:443 on every
# host address so public ingress is unaffected. Needs a standalone tailscaled up
# before k3s starts: a systemd drop-in orders k3s After= it.
flannel-iface: "{{ k3s_flannel_iface }}"
{% endif %}
