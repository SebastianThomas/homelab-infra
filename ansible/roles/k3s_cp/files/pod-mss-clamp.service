[Unit]
Description=Clamp pod-network TCP MSS (ingress over the small flannel MTU)
After=k3s.service
Wants=k3s.service

[Service]
# No RemainAfterExit: the rule it installs persists on its own (k3s only
# rewrites nat/filter, not mangle). Leaving the unit inactive lets the timer
# re-run it. Exits 0 without a rule if flannel isn't ready yet - the timer retries.
Type=oneshot
ExecStart=/usr/local/sbin/pod-mss-clamp

[Install]
WantedBy=multi-user.target
