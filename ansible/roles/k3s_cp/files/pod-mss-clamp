#!/bin/sh
# Managed by Ansible - roles/k3s_cp. Manual edits are overwritten.
#
# Clamp TCP MSS for anything forwarded into the pod network.
#
# flannel's VXLAN rides wg0, so FLANNEL_MTU is small (~1230). The public ingress
# path - klipper (ServiceLB) double-DNAT -> Traefik pod -> backend pod - then
# cannot carry a large TLS ClientHello (tailscale's, with its post-quantum key
# share, is ~1.6 KB), and the "fragmentation needed" ICMP does not survive
# klipper's NAT back to the external client. Result: a silent black hole -
# small requests (curl /health) work, the CI runner's `tailscale up` hangs.
#
# MSS clamping makes every TCP session negotiate a segment size that fits the
# pod MTU up front, so PMTU discovery never has to work.
set -eu

# Wait for flannel to publish the MTU (it writes subnet.env a few seconds after
# k3s starts); fall back to a sane value if it never shows.
mtu=1400
i=0
while [ "$i" -lt 30 ]; do
	if [ -r /run/flannel/subnet.env ]; then
		# shellcheck disable=SC1091
		. /run/flannel/subnet.env
		mtu="${FLANNEL_MTU:-$mtu}"
		break
	fi
	i=$((i + 1))
	sleep 2
done

apply() {
	# $1 = iptables|ip6tables, $2 = MSS
	"$1" -t mangle -D FORWARD -p tcp --tcp-flags SYN,RST SYN \
		-m tcpmss --mss "$(($2 + 1)):65535" -j TCPMSS --set-mss "$2" 2>/dev/null || true
	"$1" -t mangle -A FORWARD -p tcp --tcp-flags SYN,RST SYN \
		-m tcpmss --mss "$(($2 + 1)):65535" -j TCPMSS --set-mss "$2"
}

apply iptables  "$((mtu - 40))"
command -v ip6tables >/dev/null 2>&1 && apply ip6tables "$((mtu - 60))" || true

logger -t pod-mss-clamp "clamped forwarded TCP MSS to $((mtu - 40)) (FLANNEL_MTU=$mtu)"
