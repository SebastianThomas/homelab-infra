{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':dependencyDashboard',
    ':semanticCommitsDisabled',
  ],

  // Homelab: batch noise, auto-merge only the safe stuff.
  timezone: 'Europe/Zurich',
  schedule: ['before 6am on monday'],
  prConcurrentLimit: 5,
  labels: ['dependencies'],

  // Renovate's kubernetes manager has no default file list.
  kubernetes: {
    managerFilePatterns: [
      '/kubernetes/.+\\.ya?ml$/',
    ],
  },

  packageRules: [
    // Digest + patch bumps for our own-ish infra images: auto-merge.
    {
      matchManagers: ['kubernetes'],
      matchUpdateTypes: ['digest', 'patch'],
      automerge: true,
    },
    // GitHub Actions: pin, group, auto-merge minor/patch.
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'github-actions',
      automerge: true,
    },
    // K3s: never auto-merge - a node reboot / API bump is involved.
    {
      matchDepNames: ['k3s-io/k3s'],
      automerge: false,
      labels: ['dependencies', 'k3s-upgrade'],
    },
    // CloudNativePG catalog images: timestamped tags, digest-pinned. Renovate
    // can only partially track these - see kubernetes/infrastructure/cloudnative-pg.
    {
      matchPackageNames: ['ghcr.io/cloudnative-pg/**'],
      groupName: 'cloudnative-pg images',
      automerge: false,
    },
    // The catalog pins exactly one image per PG major (17 = previous,
    // 18 = current). Moving an entry across majors is a deliberate data
    // migration, never a Renovate PR - patch/minor/digest within a major only.
    {
      matchPackageNames: ['ghcr.io/cloudnative-pg/postgresql'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
  ],

  customManagers: [
    // `# renovate: datasource=X depName=Y` above a `key: "value"` (YAML)
    // or a `KEY="value"` (shell) line.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/ansible/group_vars/all/main\\.yml$/',
        '/kubernetes/bootstrap\\.sh$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\s*\\n\\s*[A-Za-z0-9_]+\\s*[:=]\\s*["\']?(?<currentValue>[^"\'\\s]+)["\']?',
      ],
    },
    // CloudNativePG per-major postgresql images (`image:` lines, tag@sha256).
    //
    // The versioning regex is load-bearing: it only ever considers tags of the
    // exact shape we pin, `<major>.<minor>-<build>-minimal-trixie`. With the
    // old `loose` versioning Renovate offered `19beta3-system-trixie` for BOTH
    // the 17 and the 18 entry at once - a beta, a different image variant, and
    // a cross-major jump (PR #7).
    {
      customType: 'regex',
      managerFilePatterns: [
        '/kubernetes/infrastructure/cloudnative-pg/image-catalog\\.yaml$/',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<build>\\d+)-minimal-trixie$',
      matchStrings: [
        'image:\\s*(?<depName>ghcr\\.io/cloudnative-pg/postgresql):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)',
      ],
    },
    // CloudNativePG extension images (`reference:` lines). Built per PG major,
    // so the `-18-trixie` suffix is pinned here too - bump it by hand when the
    // catalog's PG 18 entry moves to a new major.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/kubernetes/infrastructure/cloudnative-pg/image-catalog\\.yaml$/',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?-(?<build>\\d+)-18-trixie$',
      matchStrings: [
        'reference:\\s*(?<depName>ghcr\\.io/cloudnative-pg/[^:@\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)',
      ],
    },
    // K3s HelmChart CRs: `# renovate: chart=<name>` above a `version: "x.y.z"`.
    // All from the VictoriaMetrics Helm repo.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/kubernetes/infrastructure/monitoring/.+\\.yaml$/',
      ],
      datasourceTemplate: 'helm',
      registryUrlTemplate: 'https://victoriametrics.github.io/helm-charts',
      matchStrings: [
        '# renovate: chart=(?<depName>\\S+)\\s*\\n\\s*version:\\s*["\']?(?<currentValue>[^"\'\\s]+)["\']?',
      ],
    },
  ],
}
